# Copy to ".env" in the project root (python store.py setup does this for you).
# Every runtime secret, URL, credential and environment-specific value lives here.

# --- Django ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
LOG_LEVEL=INFO

# --- Database (SQLite fallback default for instant local setup; or PostgreSQL) ---
DB_NAME=online_store.sqlite3
DB_ENGINE=django.db.backends.sqlite3
DB_USER=store_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
# Optional superuser credentials used only by "store.py setup" to create the
# database/role if they do not exist yet. Leave empty to skip.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
# Seconds to wait when connecting to PostgreSQL.
DB_CONNECT_TIMEOUT=5

# --- API server -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8001
# Directory (relative to project root or absolute) for uploaded/generated images.
MEDIA_ROOT=media
MEDIA_URL=/media/

# --- Demo accounts created by "store.py seed" -------------------------------
SEED_ADMIN_EMAIL=admin@store.local
SEED_ADMIN_PASSWORD=change-me-admin
SEED_STAFF_EMAIL=staff@store.local
SEED_STAFF_PASSWORD=change-me-staff
SEED_CUSTOMER_EMAIL=customer@store.local
# Password for the demo customer and every generated customer account.
SEED_CUSTOMER_PASSWORD=change-me-customer

# --- AI ---------------------------------------------------------------------
# LLM for the shopping assistant / NL analytics. Leave LLM_API_KEY empty to use
# the locally trained intent classifier instead.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
# Optional pretrained CLIP for SnapCheck / photo search (needs requirements-clip.txt
# and network access to the Hugging Face hub on first use).
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
CLIP_ENABLED=true

# Model artifacts and hidden synthetic ground truth (relative to project root or absolute)
AI_MODELS_DIR=ai/models
AI_DATA_DIR=ai/data

# Unreachable API URL used by "store.py screenshots" to capture the UI's offline/error state
SCREENSHOT_OFFLINE_API_URL=http://127.0.0.1:9/api

# --- Desktop UI ---------------------------------------------------------------
UI_API_BASE_URL=http://127.0.0.1:8001/api
UI_HTTP_TIMEOUT_SECONDS=15
# File where the UI stores its JWT pair between runs (relative to the user's home).
UI_TOKEN_FILE=.online_store_ui/tokens.json
# How often the top bar refreshes the unread-notification badge
UI_NOTIFICATION_POLL_SECONDS=30
# true = the UI never calls the API and serves generated fixtures (ui/fixtures/*.json).
UI_MOCK_MODE=false
